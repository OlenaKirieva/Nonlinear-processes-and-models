      "cell_type": "code",
      "source": [
        "from sympy import symbols, Eq, solve\n",
        "\n",
        "x1, x2 = symbols('x1 x2')\n",
        "eq1 = Eq(x1 * (2 - x1 - 2*x2), 0)\n",
        "eq2 = Eq(x2 * (2 - 2*x1 - x2), 0)\n",
        "\n",
        "solutions = solve((eq1, eq2), (x1, x2))\n",
        "print(\"Нерухомі точки:\", solutions)\n"
      ],
      "metadata": {
